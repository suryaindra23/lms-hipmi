# ==========================================
# DATABASE
# ==========================================
DATABASE_URL="postgresql://admin:password@localhost:5432/lms"

# ==========================================
# JWT SECRETS (GANTI DI PRODUCTION!)
# ==========================================
JWT_SECRET="change-me-jwt-secret-min-32-chars-long-production"
JWT_REFRESH_SECRET="change-me-refresh-secret-min-32-chars-long-production"

# ==========================================
# ENCRYPTION (UNTUK NIK/KTP - GANTI DI PRODUCTION!)
# ==========================================
ENCRYPTION_KEY="change-me-encryption-key-32byte!"
BLIND_INDEX_KEY="change-me-blind-index-key-min-32-characters"

# ==========================================
# APPLICATION
# ==========================================
PORT=3000
CORS_ORIGIN="http://localhost:3001"
NODE_ENV="development"
TZ="Asia/Jakarta"
REDIS_URL="redis://localhost:6379"
WORKER_CONCURRENCY="4"
IMPORT_WORKER_CONCURRENCY="2"
IDENTITY_SCAN_CONCURRENCY="2"
NOTIFICATION_WORKER_CONCURRENCY="4"
CERTIFICATE_WORKER_CONCURRENCY="2"
ENABLE_API_DOCS="true"
ALLOW_PUBLIC_REGISTRATION="false"
PASSWORD_BCRYPT_COST="12"
REQUIRE_ADMIN_MFA="true"
MALWARE_SCANNER_REQUIRED="false"
CLAMAV_HOST=""
CLAMAV_PORT="3310"
TRUST_PROXY="false"

# Rekening tujuan pembayaran paket
PAYMENT_BANK_NAME="BCA"
PAYMENT_BANK_ACCOUNT_NUMBER="3151262625"
PAYMENT_BANK_ACCOUNT_HOLDER="Surya Indra Permana"

# Ambang alert untuk dashboard operasional.
ALERT_HTTP_ERROR_RATE="0.05"
ALERT_HTTP_P95_MS="1500"
ALERT_QUEUE_BACKLOG="100"

# Backup wajib memakai kunci terpisah dari ENCRYPTION_KEY aplikasi.
SUNRISE_BACKUP_ENCRYPTION_KEY="change-me-backup-key-min-32-characters"

# SMTP digunakan untuk undangan, reset kata sandi, dan notifikasi email.
EMAIL_PROVIDER_ENABLED="false"
SMTP_HOST=""
SMTP_PORT="587"
SMTP_SECURE="false"
SMTP_USER=""
SMTP_PASSWORD=""
EMAIL_FROM="Sunrise Academy <no-reply@sunriseadsacademy.com>"
EMAIL_REPLY_TO=""
SMTP_TLS_REJECT_UNAUTHORIZED="true"
WHATSAPP_PROVIDER_ENABLED="false"
SMS_PROVIDER_ENABLED="false"

# ==========================================
# OBJECT STORAGE PRIVAT (MinIO/S3 compatible)
# ==========================================
OBJECT_STORAGE_ENDPOINT="http://localhost:9000"
# URL yang dimasukkan ke signed upload/download URL. Pada lokal sama dengan endpoint internal.
OBJECT_STORAGE_PUBLIC_ENDPOINT="http://localhost:9000"
OBJECT_STORAGE_REGION="us-east-1"
OBJECT_STORAGE_ACCESS_KEY="sunrise-local"
OBJECT_STORAGE_SECRET_KEY="sunrise-local-secret"
OBJECT_STORAGE_PREFIX="sunrise"
OBJECT_STORAGE_AUTO_CREATE="true"

# ==========================================
# FRONTEND (Next.js)
# ==========================================
NEXT_PUBLIC_API_URL="http://localhost:3000/api/v1"
API_URL="http://localhost:3000/api/v1"
NEXT_PUBLIC_SITE_URL="http://localhost:3001"
NEXT_PUBLIC_STORAGE_ORIGIN="http://localhost:9000"
