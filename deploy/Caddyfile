{
	admin off
}

www.{$DOMAIN} {
	redir https://{$DOMAIN}{uri} permanent
}

{$DOMAIN} {
	encode zstd gzip
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		-Server
	}
	reverse_proxy web:3001
	log {
		output stdout
		format json
	}
}

storage.{$DOMAIN} {
	@preflight method OPTIONS
	handle @preflight {
		header Access-Control-Allow-Origin "https://{$DOMAIN}"
		header Access-Control-Allow-Methods "GET, HEAD, PUT, OPTIONS"
		header Access-Control-Allow-Headers "Content-Type, Authorization, X-Amz-Date, X-Amz-Content-Sha256, X-Amz-Security-Token"
		header Access-Control-Max-Age "86400"
		respond "" 204
	}

	header Access-Control-Allow-Origin "https://{$DOMAIN}"
	header X-Content-Type-Options "nosniff"
	reverse_proxy minio:9000
	log {
		output stdout
		format json
	}
}
